# Discord bot token — get from https://discord.com/developers/applications
DISCORD_TOKEN=
# Optional overrides:
# PREFIX=!
# MIN_WORDS_FOR_DETECT=3
# SKIP_CAPITALIZED=true
# REPLY_ON_MISTAKE=true
# POINTS_PER_MISTAKE=1
# DB_PATH=data/points.db
# GITHUB_REPO=Woefies/spelling-points-bot
# GITHUB_BRANCH=master
# Sync slash commands to one server instead of globally. Guild syncs show up in
# Discord instantly; the global sync can take up to an hour. Set this to your
# server's ID while testing, leave it empty in production.
# DEV_GUILD_ID=
# Where the Hunspell .dic/.aff files live. Falls back to pyspellchecker if absent.
# HUNSPELL_DIR=/usr/share/hunspell
# Needed only for AI-generated trigger replies. Without it /ai stays off and
# triggers use their stored text.
# ANTHROPIC_API_KEY=
